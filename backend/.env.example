# Local development server
APP_ENV=development
LOG_LEVEL=INFO

# mock | azure
# Use mock to run the app without Azure credentials.
# Switch to azure after configuring the search service.
SEARCH_MODE=mock

# FastAPI CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Azure AI Search (required when SEARCH_MODE=azure)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=knowledge-index
AZURE_SEARCH_API_KEY=replace-with-query-key

# Optional: request timeout in seconds
AZURE_SEARCH_TIMEOUT_SECONDS=15

# Optional: number of documents to return
AZURE_SEARCH_TOP=5

# Index field mapping — adjust to match your Azure Search index schema
AZURE_SEARCH_ID_FIELD=id
AZURE_SEARCH_TITLE_FIELD=title
AZURE_SEARCH_CONTENT_FIELD=content
AZURE_SEARCH_SOURCE_FIELD=source
AZURE_SEARCH_CATEGORY_FIELD=category

# Vector / hybrid search
# Leave AZURE_SEARCH_VECTOR_FIELD empty to use keyword search only.
# Set it to the embedding field name (for example: contentVector) to enable hybrid search.
AZURE_SEARCH_VECTOR_FIELD=
AZURE_SEARCH_VECTOR_K=5

# Optional semantic ranking configuration name from your index
AZURE_SEARCH_SEMANTIC_CONFIGURATION=
