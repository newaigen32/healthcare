# Local development server
APP_ENV=development
LOG_LEVEL=INFO

# mock | azure
# mock uses backend/app/data/documents.json (no Azure credentials required)
# azure queries Azure AI Search with keyword search
SEARCH_PROVIDER=mock

# FastAPI CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Azure AI Search (required only when SEARCH_PROVIDER=azure)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=knowledge-index
AZURE_SEARCH_API_KEY=

# Optional: request timeout in seconds
AZURE_SEARCH_TIMEOUT_SECONDS=15

# Optional: number of documents to return
AZURE_SEARCH_TOP=5

# Index field mapping — adjust to match your Azure Search index schema
AZURE_SEARCH_ID_FIELD=id
AZURE_SEARCH_TITLE_FIELD=title
AZURE_SEARCH_CONTENT_FIELD=content
AZURE_SEARCH_SOURCE_FIELD=source
AZURE_SEARCH_CATEGORY_FIELD=category
