# Local development server
APP_ENV=development
LOG_LEVEL=INFO

# postgres | mock | azure
SEARCH_PROVIDER=postgres

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Inside Docker Compose the hostname must be `db`.
# SQLAlchemy + psycopg 3 requires the +psycopg driver name.
DATABASE_URL=postgresql+psycopg://healthcare_user:changeme_local_only@localhost:5432/healthcare

AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=knowledge-index
AZURE_SEARCH_API_KEY=

AZURE_SEARCH_TIMEOUT_SECONDS=15
AZURE_SEARCH_TOP=5
AZURE_SEARCH_ID_FIELD=id
AZURE_SEARCH_TITLE_FIELD=title
AZURE_SEARCH_CONTENT_FIELD=content
AZURE_SEARCH_SOURCE_FIELD=source
AZURE_SEARCH_CATEGORY_FIELD=category
