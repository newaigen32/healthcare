# Loaded by Docker Compose for variable substitution. Copy to .env and fill in.
# Do not commit real credentials.

APP_ENV=development
SEARCH_PROVIDER=postgres
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_PASSWORD=changeme_local_only
DATABASE_URL=postgresql+psycopg://healthcare_user:changeme_local_only@db:5432/healthcare

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_TIMEOUT_SECONDS=15
AZURE_SEARCH_TOP=5
AZURE_SEARCH_ID_FIELD=id
AZURE_SEARCH_TITLE_FIELD=title
AZURE_SEARCH_CONTENT_FIELD=content
AZURE_SEARCH_SOURCE_FIELD=source
AZURE_SEARCH_CATEGORY_FIELD=category
